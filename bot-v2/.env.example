# ========================================================
# CẤU HÌNH BOT TELEGRAM BÁN HÀNG V2
# ========================================================

# 1. Thông tin tài khoản Telegram API (Lấy tại https://my.telegram.org)
API_ID=35415782
API_HASH=your_api_hash_here

# 2. Token của Bot (Tạo và lấy tại https://t.me/BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 3. Chat ID của Admin (Lấy ID cá nhân qua bot @userinfobot)
# Hỗ trợ nhiều Admin phân cách bằng dấu phẩy: 8337687095,123456789
ADMIN_CHAT_ID=8337687095

# 4. Cấu hình cổng thanh toán tự động PayOS (Lấy tại https://payos.vn)
PAYOS_CLIENT_ID=5f85719f-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAYOS_API_KEY=9d347344-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAYOS_CHECKSUM_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYOS_RETURN_URL=https://t.me
PAYOS_CANCEL_URL=https://t.me

# 5. Cấu hình tài khoản ngân hàng dự phòng (Dùng khi chưa có PayOS)
BANK_ID=MB
BANK_ACCOUNT=0912345678
BANK_ACCOUNT_NAME=VO DUC MANH

# 6. Cấu hình thời gian chờ & Sao lưu (giây)
TIMEOUT_INPUT_SECONDS=180
TIMEOUT_PAYMENT_SECONDS=600
BACKUP_INTERVAL_HOURS=12
